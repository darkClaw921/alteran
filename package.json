{
  "name": "alteran",
  "version": "0.1.0",
  "description": "alteran — coding agent terminal with a built-in phased task tracker",
  "type": "module",
  "bin": {
    "alteran": "dist/cli.js",
    "abr": "dist/abr.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "openai": "^7.21.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "smol-toml": "^1.9.0",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
