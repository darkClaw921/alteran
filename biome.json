{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist/**", "!**/node_modules/**", "!**/assets/**", "!**/.beads/**", "!**/design/**", "!**/test/fixtures/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": { "formatter": { "enabled": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noParameterAssign": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "useLiteralKeys": "off",
        "noCommaOperator": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "off",
        "useYield": "off"
      },
      "a11y": { "useKeyWithClickEvents": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["test/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "useHookAtTopLevel": "off" }
        }
      }
    },
    {
      "includes": ["src/tui/**"],
      "linter": {
        "rules": {
          "correctness": { "useExhaustiveDependencies": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
